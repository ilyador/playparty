# npm run setup generates these files and installs LiveKit automatically.
PUBLIC_URL=http://localhost:5175
BIND_ADDRESS=127.0.0.1
PORT=5175
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
PLEX_OWNER_EMAIL=
# Alternatively, use a readable Preferences.xml instead of PLEX_TOKEN.
PLEX_PREFERENCES=

AUTH_MODE=plex
LIVEKIT_MANAGED=true
LIVEKIT_API_KEY=playparty
LIVEKIT_API_SECRET=REPLACE_WITH_GENERATED_SECRET
MOVIE_UPLOAD_MBPS=70

# Optional existing authentication provider. AUTH_MODE=external disables Plex
# sign-in entirely and validates only the provider's selected session cookies.
# AUTH_MODE=external
# AUTH_URL=http://127.0.0.1:8080/api/auth/session
# AUTH_COOKIE_NAMES=owner_session
# AUTH_LOGIN_URL=https://login.example.com
# AUTH_LOGIN_LABEL=Sign in to host

# If LiveKit runs as its own service, set LIVEKIT_MANAGED=false.
# LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# LIVEKIT_PUBLIC_URL=wss://playparty.example.com/livekit
