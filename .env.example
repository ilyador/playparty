PUBLIC_URL=https://playparty.example.com
BIND_ADDRESS=127.0.0.1
PORT=5175

PLEX_URL=http://127.0.0.1:32400
# Read the Plex owner's credentials from the existing Preferences.xml:
PLEX_PREFERENCES=/path/to/plex/Preferences.xml
# Or supply PLEX_TOKEN and PLEX_OWNER_EMAIL instead of PLEX_PREFERENCES.
PLEX_TOKEN=
PLEX_OWNER_EMAIL=

# Existing homelab session validator; see README for its response contract.
HOMELAB_AUTH_URL=http://127.0.0.1:5173/api/auth/session
HOMELAB_LOGIN_URL=https://home.example.com

LIVEKIT_API_KEY=playparty
LIVEKIT_API_SECRET=REPLACE_WITH_GENERATED_SECRET
LIVEKIT_PUBLIC_URL=wss://playparty.example.com/livekit
# Keep below your measured upload speed, leaving room for the video call.
MOVIE_UPLOAD_MBPS=70
