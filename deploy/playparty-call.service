[Unit]
Description=Playparty LiveKit video call
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Dev/playparty
ExecStart=%h/Dev/playparty/bin/livekit-server --config %h/Dev/playparty/data/livekit.yaml
# LiveKit can exit with status 0 when external-IP discovery fails during boot.
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
