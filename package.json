{
  "name": "playparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "presetup": "npm run build",
    "setup": "node deploy/setup.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --disable-warning=ExperimentalWarning test/browser.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.3.0",
    "hls.js": "^1.7.3",
    "http-proxy": "^1.18.1",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
